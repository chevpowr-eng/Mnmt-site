{%- liquid
  capture trade_access
    render 'trade-access', product: product
  endcapture
  assign current_variant = product.selected_or_first_available_variant
  assign special_order = product.metafields.mnmt.special_order.value
  assign quote_only = product.metafields.mnmt.quote_only.value
  assign sample_value = settings.sample_option_value
-%}

<section class="product page-width" data-product data-overage="{{ settings.overage_percent }}">
  <div class="product__media">
    {%- for media in product.media -%}
      <div class="product__media-item{% if forloop.first %} product__media-item--main{% endif %}" data-media-id="{{ media.id }}">
        {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw' }}
      </div>
    {%- else -%}
      <div class="product__media-item product__media-item--main">{{ 'product-1' | placeholder_svg_tag: 'card__placeholder' }}</div>
    {%- endfor -%}
  </div>

  <div class="product__info">
    <p class="eyebrow"><a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a></p>
    <h1 class="product__title">{{ product.title }}</h1>

    {% render 'price', product: product, variant: current_variant, unit_label: current_variant.metafields.mnmt.sell_unit.value, show_gate_message: true %}

    {%- if special_order -%}
      <p class="notice">Special order. Lead time {{ product.metafields.mnmt.lead_time.value | default: 'quoted on request' }}.</p>
    {%- endif -%}
    {%- unless current_variant.requires_shipping -%}
      <p class="product__pickup">Showroom pickup only. We'll contact you when your order is ready.</p>
    {%- endunless -%}

    {%- form 'product', product, class: 'product__form', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="option">
            <legend class="option__label">{{ option.name }}: <span data-option-selected="{{ forloop.index0 }}">{{ option.selected_value }}</span></legend>
            <div class="option__values">
              {%- for value in option.values -%}
                <label class="pill">
                  <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}"{% if option.selected_value == value %} checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      {%- if quote_only -%}
        <a class="button button--full" href="{{ settings.quote_page.url }}?product={{ product.title | url_encode }}">Request a quote</a>
      {%- elsif trade_access == 'true' -%}
        <div class="calc" data-calc{% if current_variant.metafields.mnmt.sqft_per_box == blank %} hidden{% endif %}>
          <label class="calc__label" for="CalcArea-{{ section.id }}">Project area (sq ft)</label>
          <div class="calc__row">
            <input id="CalcArea-{{ section.id }}" class="input" type="number" min="0" step="1" inputmode="numeric" data-calc-area>
            <p class="calc__result" data-calc-result aria-live="polite"></p>
          </div>
          <p class="calc__hint">Includes {{ settings.overage_percent }}% overage for cuts and breakage.</p>
        </div>

        <div class="product__buy">
          <label class="visually-hidden" for="Quantity-{{ section.id }}">Quantity</label>
          <input id="Quantity-{{ section.id }}" class="input input--qty" type="number" name="quantity" min="1" value="1" data-quantity>
          <button type="submit" class="button button--full" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
            {%- if current_variant.available -%}Add to order{%- else -%}Out of stock{%- endif -%}
          </button>
        </div>
      {%- else -%}
        {%- assign sample_variant = product.variants | where: 'option3', sample_value | first -%}
        {%- if sample_variant -%}
          <p class="product__sample-note">Samples are available to approved specifiers.</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    {%- if product.description != blank -%}
      <div class="product__description rte">{{ product.description }}</div>
    {%- endif -%}

    {% render 'product-specs', product: product, variant: current_variant %}
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "price": {% if trade_access == 'true' %}{{ variant.price | money | json }}{% else %}null{% endif %},
            "sqftPerBox": {{ variant.metafields.mnmt.sqft_per_box.value | default: 0 | json }},
            "unit": {{ variant.metafields.mnmt.sell_unit.value | default: '' | json }},
            "mediaId": {{ variant.featured_media.id | default: 0 | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
