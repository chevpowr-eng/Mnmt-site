<section class="section page-width">
  {%- if section.settings.heading != blank -%}
    <div class="section__header">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="section__intro">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="tiles tiles--{{ section.blocks.size | at_most: 5 }}">
    {%- for block in section.blocks -%}
      {%- assign tile_collection = block.settings.collection -%}
      {%- assign tile_image = block.settings.image | default: tile_collection.featured_image -%}
      <a class="tile" href="{{ tile_collection.url | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="tile__media">
          {%- if tile_image -%}
            {{ tile_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 990px) 25vw, 50vw' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'tile__placeholder' }}
          {%- endif -%}
        </div>
        <p class="tile__title">{{ block.settings.title | default: tile_collection.title | default: 'Collection' }}</p>
        {%- if block.settings.caption != blank -%}<p class="tile__caption">{{ block.settings.caption }}</p>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Materials" },
    { "type": "richtext", "id": "text", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
