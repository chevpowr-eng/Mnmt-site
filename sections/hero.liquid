<section class="hero{% if section.settings.image == blank %} hero--plain{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}
  <div class="hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}
    <div class="button-row">
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="button button--ghost" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trade showroom" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Surfaces made by hand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Handmade tile, natural stone, artisan plaster and microcement, selected for designers and builders.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore materials" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Book a design consult" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
