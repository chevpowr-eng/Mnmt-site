<section class="section page-width">
  <div class="section__header">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="section__intro rte">{{ collection.description }}</div>{%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    <div class="collection">
      {%- if collection.filters != empty -%}
        <form class="filters" data-filters>
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'list' -%}
              <details class="filters__group"{% if filter.active_values.size > 0 %} open{% endif %}>
                <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
                <ul>
                  {%- for value in filter.values -%}
                    <li>
                      <label>
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                        {{ value.label }} <span class="filters__count">{{ value.count }}</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- endif -%}
          {%- endfor -%}
          <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
          <noscript><button class="button" type="submit">Apply</button></noscript>
          <a class="filters__clear" href="{{ collection.url }}">Clear all</a>
        </form>
      {%- endif -%}

      <div class="grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="empty">No products match these filters yet.</p>
        {%- endfor -%}
      </div>
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
