{%- comment -%}
  Specifier portal: designer cash rewards.
  Approved trade accounts see this quarter's purchases and the cash reward earned.
  The reward rate comes from the theme setting "Specifier rewards > Cash back".
{%- endcomment -%}
{%- liquid
  assign trade_access = 'false'
  if customer.b2b? or customer.tags contains settings.trade_tag
    assign trade_access = 'true'
  endif
-%}
{%- assign rate = settings.reward_percent | default: 5 -%}

<section class="section page-width page-width--narrow portal">
  <div class="section__header">
    <p class="eyebrow">Specifier portal</p>
    {%- if customer and trade_access == 'true' -%}
      <h1>{{ section.settings.heading }}</h1>
      <div class="section__intro rte">{{ section.settings.intro }}</div>
    {%- else -%}
      <h1>{{ section.settings.public_heading }}</h1>
      <div class="section__intro rte">{{ section.settings.public_intro }}</div>
    {%- endif -%}
  </div>

  {%- if customer and trade_access == 'true' -%}
    {%- liquid
      assign m = customer.metafields.mnmt
      assign my_code = m.specifier_code.value | upcase | strip
      assign my_link = shop.url | append: '/?s=' | append: my_code
    -%}
    <p class="portal__hello">Welcome back, {{ customer.first_name | default: customer.name }}.</p>

    {%- if my_code != blank -%}
      <h2 class="portal__subhead">Your specifier link</h2>
      <p class="portal__note">Send this link to your clients and builders. Every order placed through it, or with code <strong>{{ my_code }}</strong> at checkout, is credited to you.</p>
      <div class="portal__link">
        <code data-copy-source>{{ my_link }}</code>
        <button type="button" class="button button--ghost" data-copy>Copy link</button>
      </div>

      <div class="portal__stats">
        <div class="portal__stat">
          <span class="portal__label">Specified sales this quarter</span>
          <strong>{{ m.reward_q_sales.value | default: 0 | money }}</strong>
        </div>
        <div class="portal__stat portal__stat--accent">
          <span class="portal__label">Cash earned this quarter</span>
          <strong>{{ m.reward_q_earned.value | default: 0 | money }}</strong>
        </div>
        <div class="portal__stat">
          <span class="portal__label">Earned this year</span>
          <strong>{{ m.reward_y_earned.value | default: 0 | money }}</strong>
        </div>
      </div>
      <p class="portal__note">
        {%- if m.reward_updated.value != blank -%}Updated {{ m.reward_updated.value | date: '%b %-d, %Y' }}. {% endif -%}
        You earn {{ rate }}% cash back on paid orders credited to your code, before tax. We pay each quarter by Zelle or check within 30 days of quarter end.
        {%- unless customer.tags contains 'w9-on-file' %} <strong>We need a W-9 on file before your first payout.</strong>{%- endunless -%}
      </p>
    {%- else -%}
      <p class="portal__note">Your specifier link is being set up. We'll email you when it's ready.</p>
    {%- endif -%}

    {%- if customer.orders.size > 0 -%}
      <h2 class="portal__subhead">Your orders</h2>
      <table class="cart__table portal__orders">
        <thead><tr><th>Order</th><th>Date</th><th>Status</th><th class="cart__total-col">Subtotal</th></tr></thead>
        <tbody>
          {%- for order in customer.orders limit: 10 -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%b %-d, %Y' }}</td>
              <td>{% if order.cancelled %}Cancelled{% else %}{{ order.financial_status_label }}{% endif %}</td>
              <td class="cart__total-col">{{ order.subtotal_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}

    <div class="button-row">
      <a class="button" href="{{ routes.collections_url }}">Browse materials</a>
      {%- if settings.quote_page != blank -%}<a class="button button--ghost" href="{{ settings.quote_page.url }}">Request a quote</a>{%- endif -%}
      <a class="button button--ghost" href="{{ routes.account_url }}">Account</a>
    </div>

  {%- elsif customer -%}
    <p class="portal__note">Your specifier application is under review. Once you're approved, this page shows your purchases and the cash you've earned.</p>
    {%- if settings.trade_page != blank -%}<a class="button button--ghost" href="{{ settings.trade_page.url }}">Trade program</a>{%- endif -%}

  {%- else -%}
    <ol class="portal__steps">
      <li><strong>Apply</strong><span>Apply once for your studio. It's free.</span></li>
      <li><strong>Share</strong><span>Send clients and builders your personal link.</span></li>
      <li><strong>Track</strong><span>See every order specified under your name.</span></li>
    </ol>
    <div class="button-row">
      <a class="button" href="{{ routes.account_login_url }}">Log in</a>
      {%- if settings.trade_page != blank -%}<a class="button button--ghost" href="{{ settings.trade_page.url }}">Apply</a>{%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Specifier portal",
  "settings": [
    { "type": "text", "id": "public_heading", "label": "Heading (logged out)", "default": "For designers and specifiers" },
    { "type": "richtext", "id": "public_intro", "label": "Intro (logged out)", "info": "Keep reward details out of this text; only approved accounts see them.", "default": "<p>Approved trade accounts log in here to track orders and program benefits.</p>" },
    { "type": "text", "id": "heading", "label": "Heading (approved accounts)", "default": "Your cash back" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Specify MNMT materials and earn cash on every order placed through your specifier account.</p>" }
  ]
}
{% endschema %}
