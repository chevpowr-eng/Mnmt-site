<footer class="footer">
  <div class="footer__inner page-width">
    <div class="footer__brand">
      <img class="footer__mark" src="{{ 'mnmt-mark.png' | asset_url }}" alt="" width="48" height="41" loading="lazy">
      <p class="footer__name">{{ shop.name }}</p>
      {%- if settings.tagline != blank -%}<p class="footer__tagline">{{ settings.tagline }}</p>{%- endif -%}
      {%- if section.settings.address != blank -%}
        <div class="footer__address">{{ section.settings.address }}</div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <p class="footer__heading">{{ block.settings.heading }}</p>
            <ul class="footer__links">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'text' -%}
            <p class="footer__heading">{{ block.settings.heading }}</p>
            <div class="rte">{{ block.settings.text }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="footer__legal page-width">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. For specifiers.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "richtext", "id": "address", "label": "Showroom address", "default": "<p>4175 Business Dr, Suite D</p>" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Information" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Showroom visits by appointment.</p>" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
