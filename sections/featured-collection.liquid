<section class="section page-width">
  <div class="section__header section__header--row">
    <h2>{{ section.settings.heading | default: section.settings.collection.title }}</h2>
    {%- if section.settings.collection != blank -%}
      <a class="link-arrow" href="{{ section.settings.collection.url }}">View all</a>
    {%- endif -%}
  </div>
  <div class="grid">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <article class="card">
          <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'card__placeholder' }}</div>
          <div class="card__body"><p class="card__title">Product</p></div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
