<section class="section page-width page-width--narrow">
  <h1>Your order</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart">
      <table class="cart__table">
        <thead>
          <tr><th>Item</th><th>Quantity</th><th class="cart__total-col">Total</th></tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td>
                <a href="{{ item.url }}" class="cart__item">
                  {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'cart__thumb' }}{%- endif -%}
                  <span>
                    <span class="cart__vendor">{{ item.vendor }}</span>
                    {{ item.product.title }}
                    {%- unless item.product.has_only_default_variant -%}<span class="cart__variant">{{ item.variant.title }}</span>{%- endunless -%}
                  </span>
                </a>
              </td>
              <td>
                <label class="visually-hidden" for="Qty-{{ item.key }}">Quantity</label>
                <input id="Qty-{{ item.key }}" class="input input--qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </td>
              <td class="cart__total-col">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>


      {%- liquid
        assign needs_specifier = false
        for item in cart.items
          unless item.product.tags contains settings.public_price_tag
            assign needs_specifier = true
          endunless
        endfor
        assign spec_code = cart.attributes.Specifier | upcase | strip
        assign spec_name = blank
        for s in shop.metaobjects.specifier.values
          assign this_code = s.code.value | upcase | strip
          if this_code == spec_code and s.active.value != false
            assign spec_name = s.name.value
          endif
        endfor
      -%}
      {%- if needs_specifier and settings.require_specifier -%}
        <div class="specifier" data-specifier>
          <input type="hidden" name="attributes[Specifier]" value="{% if spec_name != blank or spec_code == 'NONE' %}{{ cart.attributes.Specifier }}{% endif %}" data-specifier-value>
          {%- if spec_name != blank -%}
            <p class="specifier__credited" data-specifier-credited>
              Specified by <strong>{{ spec_name }}</strong>
              <button type="button" class="link-button" data-specifier-change>Change</button>
            </p>
          {%- endif -%}
          <div class="specifier__editor" data-specifier-editor{% if spec_name != blank %} hidden{% endif %}>
            <label class="field">
              <span>Specifier code (from your designer)</span>
              <input class="input specifier__input" type="text" autocomplete="off" autocapitalize="characters"
                value="{% if spec_code != 'NONE' %}{{ spec_code }}{% endif %}" data-specifier-input>
            </label>
            <p class="specifier__status" data-specifier-status aria-live="polite"></p>
            {%- if settings.allow_no_specifier -%}
              <label class="specifier__none">
                <input type="checkbox" data-specifier-none{% if spec_code == 'NONE' %} checked{% endif %}>
                No designer on this project
              </label>
            {%- endif -%}
          </div>
          <p class="specifier__error" data-specifier-error hidden>Enter your designer's specifier code to check out.</p>
        </div>
      {%- endif -%}

      <label class="field">
        <span>Order notes (project name, delivery window, site contact)</span>
        <textarea class="input" name="note" rows="3">{{ cart.note }}</textarea>
      </label>

      <div class="cart__footer">
        <p class="cart__subtotal">Subtotal <strong>{{ cart.total_price | money }}</strong></p>
        {%- assign needs_shipping = cart.items | where: 'requires_shipping', true | size -%}
        <p class="cart__hint">
          {%- if needs_shipping > 0 -%}Tax and shipping are calculated at checkout.
          {%- else -%}Tax is calculated at checkout. Tile orders are picked up at our showroom; we'll contact you when your order is ready.{%- endif -%}
        </p>
        <div class="button-row">
          <button class="button button--ghost" type="submit" name="update">Update</button>
          <button class="button" type="submit" name="checkout">Check out</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <p>Your order is empty.</p>
    <a class="button" href="{{ routes.collections_url }}">Browse materials</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
